# Local-only settings for compose.yaml. Copy to .env to change them (.env is git-ignored).
# These are throwaway development values, never use them anywhere else.
ESCALA_DB_NAME=escala
ESCALA_DB_USER=escala
ESCALA_DB_PASSWORD=escala_local
ESCALA_DB_PORT=5432

ELEGIBILIDADE_DB_NAME=elegibilidade
ELEGIBILIDADE_DB_USER=elegibilidade
ELEGIBILIDADE_DB_PASSWORD=elegibilidade_local
ELEGIBILIDADE_DB_PORT=5433

# RabbitMQ: an admin login for the management UI, and one login per service
RABBITMQ_USER=escala
RABBITMQ_PASSWORD=escala_local
RABBITMQ_ESCALA_API_USER=escala-api
RABBITMQ_ESCALA_API_PASSWORD=escala_api_local
RABBITMQ_WORKER_USER=elegibilidade-worker
RABBITMQ_WORKER_PASSWORD=elegibilidade_worker_local
# Host ports. If Windows reports 5672 as "forbidden by its access permissions",
# Hyper-V has reserved it: set RABBITMQ_PORT=5673 (container AMQP stays 5672).
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

WEB_PORT=8000
ESCALA_API_PORT=8080
ELEGIBILIDADE_WORKER_PORT=8081

# Tracing (profile "observability"): set to true to send traces to Tempo, then open Grafana on :3000
OTEL_JAVAAGENT_ENABLED=false
GRAFANA_PASSWORD=admin_local
