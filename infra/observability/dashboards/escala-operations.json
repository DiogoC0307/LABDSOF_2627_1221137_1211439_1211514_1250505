{
  "uid": "escala-operations",
  "title": "Escala - operations",
  "description": "SLI 1 and SLI 2 of 07 · Technical Design, and the messaging, HTTP and JVM health of escala-api and elegibilidade-worker (SCRUM-97). Every query names its service with the application label.",
  "tags": ["escala", "sli"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SLI 1 - evaluation latency p95 (target < 5 s)",
      "description": "From AvaliacaoPedida written to the escala-api outbox to its AvaliacaoConcluida applied (RNF01).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 5 } ] },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(escala_evaluation_latency_seconds_bucket{application=\"escala-api\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLI 1 - evaluations within 5 s",
      "description": "Share of evaluations applied within 5 s over the dashboard range; 5 s is an exact histogram bucket.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.95 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(escala_evaluation_latency_seconds_bucket{application=\"escala-api\",le=\"5.0\"}[$__range])) / sum(increase(escala_evaluation_latency_seconds_count{application=\"escala-api\"}[$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SLI 2 - checks without DLQ or exceptional assignment (target >= 95 %)",
      "description": "1 - (messages dead-lettered by either service + exceptional assignments) / evaluations requested, over the dashboard range. Exceptional assignment (D-02) has no metric yet and counts as 0.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.95 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (sum(increase(escala_messages_dead_lettered_total{application=~\"escala-api|elegibilidade-worker\"}[$__range])) + (sum(increase(escala_assignments_exceptional_total{application=\"escala-api\"}[$__range])) or vector(0))) / sum(increase(escala_evaluations_requested_total{application=\"escala-api\"}[$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Evaluations requested and completed",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (purpose) (rate(escala_evaluations_requested_total{application=\"escala-api\"}[5m]))",
          "legendFormat": "requested {{purpose}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (result) (rate(escala_evaluations_completed_total{application=\"escala-api\"}[5m]))",
          "legendFormat": "completed {{result}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker processing p95",
      "description": "From reading an AvaliacaoPedida to writing its answer in the worker outbox: the worker's share of SLI 1.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(escala_evaluation_processing_seconds_bucket{application=\"elegibilidade-worker\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Outbox rows not published",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (application) (escala_outbox_pending{application=~\"escala-api|elegibilidade-worker\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dead-letter queues",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (queue) (escala_dlq_messages{application=~\"escala-api|elegibilidade-worker\"})",
          "legendFormat": "in {{queue}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (queue) (increase(escala_messages_dead_lettered_total{application=~\"escala-api|elegibilidade-worker\"}[1h]))",
          "legendFormat": "rejected from {{queue}} (1 h)"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Checks waiting for the worker",
      "description": "Requests escala-api sent to elegibilidade-worker that still wait for an answer, by purpose, counted in the escala-api database every 15 s (SCRUM-98). Not the size of the worker queues: a request the worker is retrying counts too, and escala-api has no permission on the worker.* queues on purpose (least privilege). It grows while the worker is down and drains when it is back.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (purpose) (escala_checks_waiting{application=\"escala-api\"})",
          "legendFormat": "{{purpose}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "escala-api HTTP requests by URI template",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{application=\"escala-api\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "escala-api HTTP 5xx share",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"escala-api\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=\"escala-api\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "JVM heap used",
      "description": "Heap only; compare with the container memory limit of each service.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (application) (jvm_memory_used_bytes{application=~\"escala-api|elegibilidade-worker\",area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ]
}
