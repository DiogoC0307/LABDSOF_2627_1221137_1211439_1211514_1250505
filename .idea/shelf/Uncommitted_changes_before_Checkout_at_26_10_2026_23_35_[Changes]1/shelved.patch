<+>@startuml\r\n' Escala domain model.\r\n' Packages are bounded contexts; the colour shows the service that owns the data.\r\n' Associations that cross from escala-api data into elegibilidade-worker data are ID references\r\n' carried by events, never foreign keys: they are drawn dashed.\r\n' Technical tables (outbox, processed events) are infrastructure and are not shown here.\r\n\r\nskinparam classAttributeIconSize 0\r\nskinparam packageStyle rectangle\r\nskinparam linetype ortho\r\nskinparam maxClassWidth 280\r\nskinparam dpi 100\r\nscale 0.85\r\nhide methods\r\nhide empty members\r\n\r\ntitle Escala — Domain model\r\n\r\nlegend bottom left\r\n  |= Colour |= Owned by |\r\n  |<#E3F2FD> | escala-api / escala-db |\r\n  |<#FFF3E0> | elegibilidade-worker / elegibilidade-db |\r\n  Dashed line: reference by ID through an event, no foreign key.\r\nendlegend\r\n\r\n' =====================================================================\r\n' escala-api — what the piquete needs\r\n' =====================================================================\r\n\r\npackage \"Personnel & Qualifications\" #E3F2FD {\r\n    class Member {\r\n        + id: UUID\r\n        + fullName: String\r\n        + rank: Rank\r\n        + rosterStatus: RosterStatus\r\n        + accessRole: AccessRole\r\n        + withinAgeLimit: Boolean\r\n        + contact: String\r\n        + active: Boolean\r\n        --\r\n        only ACTIVE_ROSTER can be scheduled\r\n        age limit stored as yes/no, no date of birth\r\n        contact shown only to roles that need it\r\n    }\r\n\r\n    enum RosterStatus {\r\n        COMMAND_ROSTER\r\n        ACTIVE_ROSTER\r\n        RESERVE_ROSTER\r\n        HONORARY_ROSTER\r\n    }\r\n\r\n    enum Rank {\r\n        CADET\r\n        TRAINEE\r\n        FIREFIGHTER_3RD_CLASS\r\n        FIREFIGHTER_2ND_CLASS\r\n        FIREFIGHTER_1ST_CLASS\r\n        SUB_CHIEF\r\n        CHIEF\r\n        OFFICER\r\n        COMMANDER\r\n        --\r\n        career category,\r\n        does not grant permissions\r\n    }\r\n\r\n    enum AccessRole {\r\n        FIREFIGHTER\r\n        DUTY_CHIEF\r\n        COMMANDER\r\n    }\r\n\r\n    class CertificationType {\r\n        + code: String\r\n        + name: String\r\n        --\r\n        e.g. TAS, TAT\r\n    }\r\n\r\n    class Certification {\r\n        + id: UUID\r\n        + issuedOn: Date\r\n        + expiresOn: Date\r\n        --\r\n        expired at slot start = does not count\r\n    }\r\n\r\n    class DrivingLicence {\r\n        + id: UUID\r\n        + licenceClass: String\r\n        + expiresOn: Date\r\n        --\r\n        must match the vehicle class\r\n    }\r\n\r\n    class ServiceHoursEntry {\r\n        + id: UUID\r\n        + date: Date\r\n        + hours: Decimal\r\n        + category: HoursCategory\r\n        --\r\n        created from confirmed\r\n        assignments, never self-declared\r\n    }\r\n\r\n    enum HoursCategory {\r\n        EMERGENCY_STANDBY\r\n        TRAINING\r\n        OTHER\r\n    }\r\n}\r\n\r\npackage \"Roster & Slots\" #E3F2FD {\r\n    class Vehicle {\r\n        + id: UUID\r\n        + code: String\r\n        + type: VehicleType\r\n        + requiredLicenceClass: String\r\n    }\r\n\r\n    class VehicleType {\r\n        + code: String\r\n        + name: String\r\n        --\r\n        e.g. ambulance, fire engine\r\n    }\r\n\r\n    class CompositionRule {\r\n        + id: UUID\r\n        + riskLevel: RiskLevel\r\n        + role: SlotRole\r\n        + minimumCount: Integer\r\n        + version: String\r\n        --\r\n        configuration, not code\r\n    }\r\n\r\n    class Piquete {\r\n        + id: UUID\r\n        + dutyDate: Date\r\n        + period: ShiftPeriod\r\n        + start: Instant\r\n        + end: Instant\r\n        --\r\n        instants in UTC\r\n    }\r\n\r\n    enum ShiftPeriod {\r\n        DAY\r\n        NIGHT\r\n    }\r\n\r\n    class Slot {\r\n        + id: UUID\r\n        + role: SlotRole\r\n        + status: SlotStatus\r\n        --\r\n        open when no confirmed assignment\r\n    }\r\n\r\n    enum SlotRole {\r\n        CREW_CHIEF\r\n        DRIVER\r\n        CREW_MEMBER\r\n    }\r\n\r\n    enum SlotStatus {\r\n        OPEN\r\n        PROPOSED\r\n        FILLED\r\n    }\r\n\r\n    class Assignment {\r\n        + id: UUID\r\n        + status: AssignmentStatus\r\n        + evaluationState: EvaluationState\r\n        + evaluationId: UUID\r\n        + result: EligibilityResult\r\n        + violatedRuleCodes: List<String>\r\n        + engineVersion: String\r\n        + exceptionalReason: String\r\n        + proposedAt: Instant\r\n        + confirmedAt: Instant\r\n        --\r\n        no overlap for the same member\r\n        never inside a confirmed unavailability\r\n        confirm only when EVALUATED + ELIGIBLE\r\n    }\r\n\r\n    enum AssignmentStatus {\r\n        PROPOSED\r\n        CONFIRMED\r\n        EXCEPTIONAL\r\n        CANCELLED\r\n    }\r\n\r\n    enum EvaluationState {\r\n        PENDING\r\n        EVALUATED\r\n        FAILED\r\n        OUTDATED\r\n    }\r\n\r\n    class DailyRisk {\r\n        + date: Date\r\n        + rcm: RiskLevel\r\n        + fetchedAt: Instant\r\n        + assumedHigher: Boolean\r\n        --\r\n        read model fed by RiscoAtualizado\r\n        stale = higher level\r\n    }\r\n}\r\n\r\npackage \"Unavailability & Coverage\" #E3F2FD {\r\n    class Unavailability {\r\n        + id: UUID\r\n        + type: UnavailabilityType\r\n        + start: Instant\r\n        + end: Instant\r\n        + dailyWindowFrom: LocalTime\r\n        + dailyWindowTo: LocalTime\r\n        + source: DeclarationSource\r\n        + readAutomatically: Boolean\r\n        + confirmed: Boolean\r\n        --\r\n        no reason stored (may be health data)\r\n    }\r\n\r\n    class FreeTextMessage {\r\n        + id: UUID\r\n        + text: String\r\n        + referenceDate: Date\r\n        + receivedAt: Instant\r\n        --\r\n        transient; deleted after\r\n        confirmation or discard\r\n    }\r\n\r\n    enum UnavailabilityType {\r\n        UNAVAILABLE\r\n        PARTIAL\r\n    }\r\n\r\n    enum DeclarationSource {\r\n        FORM\r\n        FREE_TEXT\r\n    }\r\n\r\n    class CoverRequest {\r\n        + id: UUID\r\n        + status: CoverRequestStatus\r\n        + gapDetectedAt: Instant\r\n        + filledAt: Instant\r\n    }\r\n\r\n    enum CoverRequestStatus {\r\n        OPEN\r\n        FILLED\r\n        CANCELLED\r\n        EXPIRED\r\n    }\r\n\r\n    class Application {\r\n        + id: UUID\r\n        + appliedAt: Instant\r\n        + status: ApplicationStatus\r\n        --\r\n        never confirmed by the applicant\r\n    }\r\n\r\n    enum ApplicationStatus {\r\n        SUBMITTED\r\n        SELECTED\r\n        NOT_SELECTED\r\n        WITHDRAWN\r\n    }\r\n\r\n    class Notification {\r\n        + id: UUID\r\n        + type: NotificationType\r\n        + createdAt: Instant\r\n        + readAt: Instant\r\n    }\r\n\r\n    enum NotificationType {\r\n        COVER_REQUEST_OPENED\r\n        ASSIGNMENT_CONFIRMED\r\n        ASSIGNMENT_CANCELLED\r\n        COMPOSITION_BELOW_REQUIRED\r\n        CERTIFICATION_EXPIRING\r\n    }\r\n}\r\n\r\npackage \"Audit\" #E3F2FD {\r\n    class AuditRecord {\r\n        + id: UUID\r\n        + action: AuditAction\r\n        + occurredAt: Instant\r\n        + entityType: String\r\n        + entityId: UUID\r\n        + oldValue: JSON\r\n        + newValue: JSON\r\n        + engineVersion: String\r\n        + reason: String\r\n        --\r\n        append-only\r\n    }\r\n\r\n    enum AuditAction {\r\n        ASSIGNMENT_CONFIRMED\r\n        EXCEPTIONAL_ASSIGNMENT\r\n        CERTIFICATION_CHANGED\r\n        UNAVAILABILITY_CONFIRMED\r\n        ROLE_CHANGED\r\n    }\r\n}\r\n\r\n' =====================================================================\r\n' elegibilidade-worker — who can fill it\r\n' =====================================================================\r\n\r\npackage \"Eligibility\" #FFF3E0 {\r\n    class EligibilityEvaluation {\r\n        + id: UUID\r\n        + requestEventId: UUID\r\n        + assignmentId: UUID\r\n        + memberId: UUID\r\n        + result: EligibilityResult\r\n        + engineVersion: String\r\n        + evaluatedAt: Instant\r\n        --\r\n        deterministic rules, no AI\r\n        requestEventId unique = idempotency\r\n    }\r\n\r\n    class ViolatedRule {\r\n        + ruleCode: String\r\n        + explanation: String\r\n    }\r\n\r\n    enum EligibilityResult {\r\n        ELIGIBLE\r\n        INELIGIBLE\r\n    }\r\n}\r\n\r\npackage \"AI Extraction\" #FFF3E0 {\r\n    class UnavailabilityExtraction {\r\n        + id: UUID\r\n        + requestEventId: UUID\r\n        + unavailabilityRequestId: UUID\r\n        + proposedType: ExtractionType\r\n        + proposedStart: Instant\r\n        + proposedEnd: Instant\r\n        + method: ExtractionMethod\r\n        + latencyMs: Integer\r\n        + extractedAt: Instant\r\n        --\r\n        only a proposal, confirmed by the member\r\n    }\r\n\r\n    enum ExtractionType {\r\n        UNAVAILABLE\r\n        PARTIAL\r\n        NOT_AN_UNAVAILABILITY\r\n    }\r\n\r\n    enum ExtractionMethod {\r\n        MODEL\r\n        BASELINE\r\n        FALLBACK\r\n    }\r\n}\r\n\r\npackage \"Fire Risk\" #FFF3E0 {\r\n    class RiskObservation {\r\n        + id: UUID\r\n        + dico: String\r\n        + forecastDate: Date\r\n        + rcm: RiskLevel\r\n        + fetchedAt: Instant\r\n        + source: RiskSource\r\n        --\r\n        hourly poll, last valid value cached\r\n    }\r\n\r\n    class WeatherWarning {\r\n        + id: UUID\r\n        + areaCode: String\r\n        + type: String\r\n        + level: String\r\n        + start: Instant\r\n        + end: Instant\r\n    }\r\n\r\n    enum RiskLevel {\r\n        REDUCED = 1\r\n        MODERATE = 2\r\n        HIGH = 3\r\n        VERY_HIGH = 4\r\n        MAXIMUM = 5\r\n    }\r\n\r\n    enum RiskSource {\r\n        IPMA\r\n        SIMULATOR\r\n    }\r\n}\r\n\r\n' =====================================================================\r\n' Relationships — escala-api (foreign keys inside escala-db)\r\n' =====================================================================\r\n\r\nMember \"1\" *-- \"0..*\" Certification : holds >\r\nCertification \"0..*\" --> \"1\" CertificationType : of type >\r\nMember \"1\" *-- \"0..*\" DrivingLicence : holds >\r\nMember \"1\" *-- \"0..*\" ServiceHoursEntry : accumulates >\r\nMember \"1\" *-- \"0..*\" Unavailability : declares >\r\nMember \"1\" -- \"0..*\" Application : submits >\r\nMember \"1\" -- \"0..*\" Assignment : receives >\r\nMember \"1\" -- \"0..*\" Notification : receives >\r\nMember \"1\" -- \"0..*\" AuditRecord : authors >\r\n\r\nVehicle \"0..*\" --> \"1\" VehicleType : of type >\r\nCompositionRule \"0..*\" --> \"1\" VehicleType : for >\r\n\r\nPiquete \"1\" *-- \"1..*\" Slot : composed of >\r\nPiquete \"0..*\" --> \"0..1\" DailyRisk : planned for risk of >\r\nSlot \"0..*\" --> \"1\" Vehicle : crews >\r\nSlot \"0..*\" --> \"0..1\" CertificationType : requires >\r\nSlot \"1\" -- \"0..*\" Assignment : filled by >\r\nSlot \"1\" -- \"0..*\" CoverRequest : opened for >\r\n\r\nCoverRequest \"1\" -- \"0..*\" Application : receives >\r\nApplication \"0..1\" -- \"0..1\" Assignment : leads to >\r\nAssignment \"0..1\" -- \"0..*\" ServiceHoursEntry : counts as >\r\n\r\nUnavailability \"1\" *-- \"0..1\" FreeTextMessage : declared through >\r\n\r\n' =====================================================================\r\n' Relationships — elegibilidade-worker (foreign keys inside elegibilidade-db)\r\n' =====================================================================\r\n\r\nEligibilityEvaluation \"1\" *-- \"0..*\" ViolatedRule : lists >\r\n\r\n' =====================================================================\r\n' Cross-service references (IDs carried by events, no foreign keys)\r\n' =====================================================================\r\n\r\nAssignment \"1\" ..> \"0..*\" EligibilityEvaluation : AvaliacaoPedida / AvaliacaoConcluida >\r\nFreeTextMessage \"1\" ..> \"0..1\" UnavailabilityExtraction : ExtracaoPedida / ExtracaoConcluida >\r\nRiskObservation \"0..*\" ..> \"0..1\" DailyRisk : RiscoAtualizado >\r\n\r\n@enduml\r\n\r\n
